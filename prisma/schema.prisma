generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Stock {
  id          String  @id @default(cuid())
  symbol      String  @unique
  companyName String
  market      String
  sector      String?
  industry    String?

  currentPrice Float?
  currency     String?

  recommendations Recommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HistoricalPrice {
  id String @id @default(cuid())

  symbol  String
  date    DateTime

  open    Float
  high    Float
  low     Float
  close   Float
  volume  Float

  change        Float?
  changePercent Float?
  vwap          Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, date])
  @@index([symbol])
  @@index([symbol, date])
}

model CompanyProfile {
  id String @id @default(cuid())

  symbol String @unique

  companyName String
  price Float
  change Float
  changePercentage Float

  exchange String
  industry String
  sector String

  website String
  image String
  ceo String

  marketCap Float
  country String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model IncomeStatement {
  id String @id @default(cuid())

  symbol String
  date DateTime

  fiscalYear String
  period String
  reportedCurrency String

  revenue Float
  grossProfit Float
  operatingIncome Float
  ebitda Float
  netIncome Float
  epsDiluted Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, date])
  @@unique([symbol])
}

model Recommendation {
  id String @id @default(cuid())

  stockId String
  stock   Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)

  score Float

  recommendation RecommendationType

  reasoning String?

  createdAt DateTime @default(now())
}

model Watchlist {
  id String @id @default(cuid())

  symbol String @unique

  createdAt DateTime @default(now())
}

enum RecommendationType {
  BUY
  HOLD
  SELL
}
